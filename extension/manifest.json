{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Preguntazo",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "author": "Miguel Mogrovejo",
  "homepage_url": "https://mjmc4498.github.io/preguntazo/",
  "default_locale": "es",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "offscreen", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "__MSG_cmdOpen__"
    },
    "toggle-qr": {
      "suggested_key": { "default": "Alt+Shift+Q" },
      "description": "__MSG_cmdQr__"
    },
    "next-question": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "__MSG_cmdNext__"
    },
    "clear-screen": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "__MSG_cmdClear__"
    }
  }
}
